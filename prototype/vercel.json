{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/turn", "destination": "/api/turn" },
    { "source": "/api/:route(health|judge|voice|tts)", "destination": "/api/turn?route=:route" }
  ]
}
